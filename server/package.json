{
  "name": "server",
  "version": "1.0.0",
  "main": "app.js",
  "type": "module",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit",
    "Xamp": "sudo /opt/lampp/lampp start",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects unit --coverage",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects integration --runInBand",
    "test:copy": "node --experimental-vm-modules node_modules/jest/bin/jest.js --selectProjects copy --runInBand",
    "db:migrate": "node scripts/migrate.js",
    "db:copy-from-mysql": "node scripts/mysql-to-postgres/index.js",
    "db:new": "dbmate --migrations-dir db/migrations new",
    "test:all": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "seed:quiz": "node scripts/seedQuizQuestions.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "multer-storage-cloudinary": "^4.0.0",
    "mysql2": "^3.12.0",
    "pg": "^8.23.1",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "dbmate": "^2.37.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  }
}
