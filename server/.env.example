# Copy to server/.env for running the server without Docker (npm run dev).
PORT=3000
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30h
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=School_Management
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Time zone for fee due dates and late fines (default Asia/Dhaka).
SCHOOL_TIME_ZONE=Asia/Dhaka

# Behind a reverse proxy you run (nginx, Caddy, a load balancer) that sets
# X-Forwarded-For, say which proxies to trust so the server sees visitors'
# real addresses (used to slow down job application spam): a hop count such
# as 1, or "loopback, uniquelocal". Leave empty when the API is reached directly.
TRUST_PROXY=
# Online job applications allowed per visitor address per hour (default 10).
JOB_APPLICATIONS_PER_HOUR=10
