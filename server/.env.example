# Copy to server/.env for running the server without Docker (npm run dev).
PORT=3000
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30h
# postgres (default from the cutover on) or mysql (the old database).
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=school
DB_PASSWORD=change-me
DB_NAME=School_Management
# The database session's time zone (CURRENT_DATE, NOW()); default: the server's.
DB_TIMEZONE=Asia/Dhaka
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Time zone for fee due dates and late fines (default Asia/Dhaka).
SCHOOL_TIME_ZONE=Asia/Dhaka

# Behind a reverse proxy you run (nginx, Caddy, a load balancer) that sets
# X-Forwarded-For, say which proxies to trust so the server sees visitors'
# real addresses (used to slow down job application spam): a hop count such
# as 1, or "loopback, uniquelocal". Leave empty when the API is reached directly.
TRUST_PROXY=
# Online job applications allowed per visitor address per hour (default 10).
JOB_APPLICATIONS_PER_HOUR=10

# ── Attendance app and absence SMS ──
# Sign-in attempts to the teachers' attendance app per address per 15 minutes
# (each mobile number is also locked for 15 minutes after 5 wrong passwords).
TEACHER_APP_LOGINS_PER_15_MINUTES=20
# SMS to parents when a child is marked absent: one per child per day, sent
# ATTENDANCE_SMS_DELAY_MINUTES after the day is saved, if the child is still absent.
ATTENDANCE_SMS_ENABLED=false
ATTENDANCE_SMS_DELAY_MINUTES=15
# log = write messages to the server log only (try it out first);
# bulksmsbd = send through BulkSMSBD (bulksmsbd.net) with your API key and sender id.
SMS_PROVIDER=log
SMS_API_URL=https://bulksmsbd.net/api/smsapi
SMS_API_KEY=
SMS_SENDER_ID=
# The name at the end of each SMS.
SMS_SIGNATURE=স্টার শিক্ষা পরিবার
