# Copy to .env (next to docker-compose.yml) and fill in real values.
# .env is git-ignored — never commit it.

# PostgreSQL password (used by the postgres container, migrations and the backend)
POSTGRES_PASSWORD=change-me
# Host port for PostgreSQL (change it if 5433 is already used on this machine)
POSTGRES_PORT=5433
DB_NAME=School_Management

# Long random string, e.g. output of: openssl rand -hex 32
JWT_SECRET_KEY=change-me
JWT_EXPIRES_IN=30h

# From https://console.cloudinary.com → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Behind your own reverse proxy (nginx, Caddy, ...) that sets X-Forwarded-For:
# which proxies to trust, e.g. 1 (one hop) or "loopback, uniquelocal".
# Leave empty if visitors reach the API directly.
TRUST_PROXY=
# Online job applications allowed per visitor address per hour.
JOB_APPLICATIONS_PER_HOUR=10

# ── Attendance app and absence SMS ──
# Sign-in attempts to the teachers' attendance app per address per 15 minutes
# (each mobile number is also locked for 15 minutes after 5 wrong passwords).
TEACHER_APP_LOGINS_PER_15_MINUTES=20
# SMS to parents when a child is marked absent: one per child per day, sent
# ATTENDANCE_SMS_DELAY_MINUTES after the day is saved, if the child is still absent.
ATTENDANCE_SMS_ENABLED=false
ATTENDANCE_SMS_DELAY_MINUTES=15
# log = write messages to the server log only (try it out first);
# bulksmsbd = send through BulkSMSBD (bulksmsbd.net) with your API key and sender id.
SMS_PROVIDER=log
SMS_API_URL=https://bulksmsbd.net/api/smsapi
SMS_API_KEY=
SMS_SENDER_ID=
# The name at the end of each SMS.
SMS_SIGNATURE=স্টার শিক্ষা পরিবার
